<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-5MHWQYG4MV"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-5MHWQYG4MV');
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}" />
  {%- endif %}
  {#- The one official address of this page: always www, and the home as / rather
      than /index.html, so Google doesn't count the variants as separate pages. #}
  {%- set pageUrl = "https://www.yabintorres.com" + (page.url | replace("/index.html", "/")) %}
  <link rel="canonical" href="{{ pageUrl }}" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  {#- Case studies set their own sheet in cases/cases.11tydata.json. Bump the
      ?v= when styles.css changes so no browser keeps a stale copy. #}
  <link rel="stylesheet" href="{{ stylesheet or '/css/styles.css?v=23' }}" />
{% block head %}{% endblock %}
</head>

<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>{% block body %}{% endblock %}</body>
</html>
